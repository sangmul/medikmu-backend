# Copy to .env for local development. Never commit .env.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug

# docker-compose overrides these for the api container; they are used when running on the host.
DATABASE_URL=postgres://medikmu:medikmu@localhost:5432/medikmu?sslmode=disable
REDIS_URL=redis://localhost:6379

# Must be 32+ characters (the app refuses to start otherwise). Generate: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
JWT_ISSUER=medikmu
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
